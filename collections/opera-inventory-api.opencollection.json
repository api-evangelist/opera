              "token": "{{bearerToken}}"
            }
          },
          "docs": "Create a new app (inventory) entry for a publisher."
        },
        {
          "info": {
            "name": "Update app",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://ofa.adx.opera.com/oapi/v1/app/update",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Modify an existing app entry (supports partial updates)."
        },
        {
          "info": {
            "name": "List apps",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://ofa.adx.opera.com/oapi/v1/app/list",
