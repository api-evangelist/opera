{
  "opencollection": "1.0.0",
  "info": {
    "name": "Opera Ads Open Inventory Report API",
    "version": "v1"
  },
  "items": [
    {
      "info": {
        "name": "Report",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get daily campaign report",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://ofa.adx.opera.com/oapi/v1/report/campaign_daily",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Retrieve daily report data for advertiser campaigns including impressions, clicks, conversions and spend, filtered by day range and optionally by order, line item, or creative."
        }
      ]
    }
  ],
  "bundled": true
}